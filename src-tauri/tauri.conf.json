{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clearsight",
  "version": "1.0.1",
  "identifier": "io.github.wyze3306.clearsight",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clearsight",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "System monitor and cleaner for Linux",
    "longDescription": "Clearsight shows every running app and process, what uses your CPU, memory and disk, how your drives (including encrypted ones) are laid out, and lets you free memory and storage in a few clicks.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["pkexec | policykit-1", "xdg-utils"],
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
